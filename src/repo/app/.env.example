# Variables para docker compose (app/.env)
# Copiar a .env y ajustar según el entorno.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bd252

# Backend
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000

# Resiliencia de VictoriaMetrics (ver docs/resiliencia.md)
VICTORIA_METRICS_URL=http://localhost:8428
VICTORIA_METRICS_TIMEOUT_MS=2000
VICTORIA_METRICS_CIRCUIT_ERROR_PERCENTAGE=50
VICTORIA_METRICS_CIRCUIT_MIN_CALLS=5
VICTORIA_METRICS_CIRCUIT_WINDOW_MS=10000
VICTORIA_METRICS_CIRCUIT_RESET_MS=15000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001